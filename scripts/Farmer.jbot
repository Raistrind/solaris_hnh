//#! name = Farmer
//#! uniq = farmer_apxproductions
//#! icon = gfx/invobjs/carrot

/*
 * Area Farmer for Legacy Haven & Hearth.
 *
 * This file intentionally contains only the current area workflow.  The old
 * crop-specific farmer and its first crop menu were removed: keeping both
 * workflows in one script made it possible for stale globals and duplicate
 * helpers to intercept the new menu action.
 */
include("pathfinder");
include("jBotAPI");
include("jBotErik");

var AREA_FARMER_TIMEOUT = 1000 * 60 * 2;
var AREA_FARMER_UI_TIMEOUT = 1000 * 60 * 5;
var AREA_FARMER_PLANT_TIMEOUT = 1000 * 10;
var areaFarmerStop = false;

function AreaCropProfile(label, cropName, seedNames, displayedCropStages, allowsDirectInventorySeed) {
   this.label = label;
   this.cropName = cropName;
   this.cropSeedNames = (seedNames instanceof Array) ? seedNames : [seedNames];
   /* The Legacy UI labels the zero-based plant blob as stage + 1. Keep the
    * profile values in the player's displayed terminology, then convert them
    * once for jGetObjectsInRect(), which filters on blob(0). */
   if (!(displayedCropStages instanceof Array)) displayedCropStages = [displayedCropStages];
   this.cropStages = [];
   for (var i = 0; i < displayedCropStages.length; i++)
      this.cropStages.push(displayedCropStages[i] - 1);
   this.cropStage = this.cropStages[0];
   /* Some Legacy crops can be replanted from the harvested item itself. */
   this.allowsDirectInventorySeed = allowsDirectInventorySeed == true;
}

function areaFarmerProfiles() {
   return [
      /* Displayed stage 4 produces carrot seeds; displayed stage 5 is final. */
      new AreaCropProfile("Carrot", "plants/carrot", ["invobjs/seed-carrot", "invobjs/carrot"], [4, 5], true),
      new AreaCropProfile("Poppy", "plants/poppy", "invobjs/seed-poppy", 4),
      new AreaCropProfile("Wheat", "plants/wheat", ["invobjs/seed-wheat", "invobjs/wheat", "wheat"], 3),
      new AreaCropProfile("Hemp", "plants/hemp", "invobjs/seed-hemp", 4),
      new AreaCropProfile("Beetroot", "plants/beetroot", ["invobjs/beetroot", "beetroot", "invobjs/seed-beetroot"], 3, true),
      new AreaCropProfile("Grapes", "plants/wine", ["invobjs/seed-grape", "invobjs/grapes"], 3),
      new AreaCropProfile("Tea", "plants/tea", "invobjs/seed-tea", 3),
      new AreaCropProfile("Flax", "plants/flax", "invobjs/flaxseed", 3),
      new AreaCropProfile("Peppercorn", "plants/pepper", ["invobjs/peppercorn", "invobjs/seed-pepper", "invobjs/pepper"], 3),
      new AreaCropProfile("Hops", "plants/hops", ["invobjs/hopcones", "invobjs/hop-cones", "invobjs/seed-hops"], 3),
      new AreaCropProfile("Peas", "plants/peas", ["invobjs/peapod", "invobjs/seed-peas"], 4, true),
      new AreaCropProfile("Onions", "plants/onion", ["invobjs/onion", "invobjs/red-onion", "invobjs/yellow-onion"], 3, true),
      new AreaCropProfile("Tobacco", "plants/tobacco", "invobjs/seed-tobacco", 3),
      new AreaCropProfile("Pumpkin", "plants/pumpkin", "invobjs/seed-pumpkin", 6)
   ];
}

function areaFarmerChooseProfile() {
   var profiles = areaFarmerProfiles();
   var win = null;
   try {
      var height = 30 + ((profiles.length + 1) * 25);
      win = jGUIWindow(jCoord(300, 250), jCoord(220, height), "Area Farmer");
      jGUILabel(win, jCoord(5, 5), "Select the crop in the area:");
      var i;
      for (i = 0; i < profiles.length; i++)
         jGUIButton(win, jCoord(5, 25 + i * 25), 210, profiles[i].label);
      jGUIButton(win, jCoord(5, 25 + profiles.length * 25), 210, "Exit");
      win.toggleCloseButton();
      var selected = win.waitButtonClick(AREA_FARMER_UI_TIMEOUT);
      if (selected == null || selected == "" || selected == "Exit") return null;
      for (i = 0; i < profiles.length; i++)
         if (selected == profiles[i].label) return profiles[i];
      jToConsole("AREA FARMER: unknown crop button '" + selected + "'.");
      return null;
   } finally {
      if (win != null) win.destroy();
   }
}

function areaFarmerWindowInventory(wnd) {
   var waited = 0;
   while (wnd != null && waited < AREA_FARMER_TIMEOUT) {
      var inventories = wnd.getInventories();
      if (inventories != null && inventories.length > 0) return inventories[0];
      jSleep(100);
      waited += 100;
   }
   return null;
}

function areaFarmerOpenSeedbags(inv) {
   var bags = inv.getItems("invobjs/bag-seed");
   if (bags.length == 0) return false;
   var target = bags.length;
   var windows = jGetWindows("Seedbag");
   var alreadyOpen = windows.length;
   jToConsole("AREA FARMER: opening seed bags (" + alreadyOpen + "/" + target + ").");
   var i;
   for (i = alreadyOpen; i < bags.length; i++) {
      if (bags[i].isActual()) bags[i].iact();
      jSleep(150);
   }
   var waited = 0;
   while (jGetWindows("Seedbag").length < target && waited < AREA_FARMER_TIMEOUT) {
      jSleep(100);
      waited += 100;
   }
   var opened = jGetWindows("Seedbag").length;
   if (opened < target)
      jToConsole("AREA FARMER: only " + opened + "/" + target + " seed bags opened; continuing with those available.");
   return opened > 0;
}

function areaFarmerSeedBagCount(inv) {
   return inv.getItems("invobjs/bag-seed").length;
}

function areaFarmerSeedBagFreeSlots() {
   var free = 0;
   var windows = jGetWindows("Seedbag");
   for (var i = 0; i < windows.length; i++) {
      var inv = areaFarmerWindowInventory(windows[i]);
      if (inv != null) free += inv.freeSlots();
   }
   return free;
}

function areaFarmerGetSeedItems(inv, names) {
   /* Use exact resource matching. getItems() is substring-based, so a
    * request for invobjs/beetroot would otherwise also return beetrootleaves. */
   for (var i = 0; i < names.length; i++) {
      var found = inv.getEqualItems(names[i]);
      if (found.length > 0) return found;
   }
   return [];
}

function areaFarmerSeedItems(profile, playerInv) {
   var seeds = [];
   var windows = jGetWindows("Seedbag");
   var i, j, inv, found;
   for (i = 0; i < windows.length; i++) {
      inv = areaFarmerWindowInventory(windows[i]);
      if (inv == null) continue;
      found = areaFarmerGetSeedItems(inv, profile.cropSeedNames);
      for (j = 0; j < found.length; j++) if (found[j].isActual()) seeds.push(found[j]);
   }
   found = areaFarmerGetSeedItems(playerInv, profile.cropSeedNames);
   for (i = 0; i < found.length; i++) if (found[i].isActual()) seeds.push(found[i]);
   seeds.sort(function(a, b) { return b.quality() - a.quality(); });
   return seeds;
}

function areaFarmerSortCrops(crops, origin) {
   crops.sort(function(a, b) {
      var ap = a.position(), bp = b.position();
      var ay = Math.floor((ap.y - origin.y) / 11), by = Math.floor((bp.y - origin.y) / 11);
      if (ay != by) return ay - by;
      var ax = Math.floor((ap.x - origin.x) / 11), bx = Math.floor((bp.x - origin.x) / 11);
      return ((ay & 1) == 0) ? ax - bx : bx - ax;
   });
}

function areaFarmerWalkTo(pos) {
   var target = jTilify(pos);
   if (jMyCoords().dist(target) <= 1) return true;
   resetCursor();
   if (jIsPathFree(target)) jAbsClick(target, 1, 0);
   else if (jPFMove(target) <= 0) return false;
   if (!jWaitStartMove(1500)) return false;
   waitPFEndMove();
   return jMyCoords().dist(target) <= 33;
}

function areaFarmerHarvestOne(crop, ordinal, total) {
   if (crop == null || !crop.isActual()) return false;
   if (checkInventory().freeSlots() <= 0) {
      jToConsole("AREA FARMER: inventory full; stopped harvest at " + ordinal + "/" + total + ".");
      return false;
   }
   var pos = crop.position();
   if (!areaFarmerWalkTo(pos)) return false;
   resetCursor();
   jSendAction("harvest");
   if (!jWaitCursor("harvest", AREA_FARMER_TIMEOUT)) return false;
   jDoClick(crop.getID(), 1, 0);
   jWaitProgress(AREA_FARMER_TIMEOUT);
   jToConsole("AREA FARMER: harvested " + ordinal + "/" + total + ".");
   return true;
}

function areaFarmerPlantOne(profile, pos, ordinal, total) {
   var playerInv = checkInventory();
   var seeds = areaFarmerSeedItems(profile, playerInv);
   if (seeds.length == 0) return false;
   if (!areaFarmerWalkTo(pos)) return false;
   resetCursor();
   var seed = seeds[0];
   if (!seed.isActual()) return false;
   seed.take();
   if (!jWaitDrag(AREA_FARMER_TIMEOUT)) return false;
   jInteractClick(jCoord(0, 0), 0);
   if (!jWaitDrop(AREA_FARMER_PLANT_TIMEOUT)) return false;
   jToConsole("AREA FARMER: replanted " + ordinal + "/" + total + ".");
   return true;
}

function areaFarmerHasPosition(pos, positions) {
   for (var i = 0; i < positions.length; i++)
      if (positions[i].x == pos.x && positions[i].y == pos.y) return true;
   return false;
}

function areaFarmerBuildPlantPositions(rect, harvestedPositions) {
   var freshlyHarvested = [], emptyPlowed = [], area = rect[4];
   for (var y = 0; y < area.y; y++) {
      for (var x = 0; x < area.x; x++) {
         var pos = jCoord(rect[0].x + x * 11, rect[0].y + y * 11);
         /* Legacy has one ordinary plowed-soil tile type (9). */
         if (jAbsTileType(pos.div(11)) != 9) continue;
         var existing = jFindMapObjectNearAbs(pos, 1, "plants/");
         if (existing != null) {
            /* Only a tile harvested during this cycle is allowed to retain a
             * still-disappearing plant gob as a planting target. */
            if (areaFarmerHasPosition(pos, harvestedPositions)) freshlyHarvested.push(pos);
            continue;
         }
         if (areaFarmerHasPosition(pos, harvestedPositions)) freshlyHarvested.push(pos);
         else emptyPlowed.push(pos);
      }
   }
   /* Freshly harvested tiles must be consumed first. Historical harvested
    * positions are deliberately not passed here, otherwise the next cycle
    * starts by selecting the crops that were just planted. */
   return freshlyHarvested.concat(emptyPlowed);
}

function areaFarmerFindCrops(profile, rect, harvestedPositions) {
   var area = rect[4];
   var crops = [];
   var seen = {};
   for (var stageIndex = 0; stageIndex < profile.cropStages.length; stageIndex++) {
      var foundJava = jGetObjectsInRect(rect[0], area.sub(1, 1), profile.cropStages[stageIndex], [profile.cropName]);
      for (var i = 0; i < foundJava.length; i++) {
         var gobKey = "" + foundJava[i].getID();
         if (seen[gobKey]) continue;
         seen[gobKey] = true;
         var pos = jTilify(foundJava[i].position());
         if (!areaFarmerHasPosition(pos, harvestedPositions)) crops.push(foundJava[i]);
      }
   }
   areaFarmerSortCrops(crops, rect[0]);
   return crops;
}

function areaFarmerHarvestCapacity(profile, playerInv) {
   /* When the crop is being replanted from an item in the player inventory,
    * seed bags are irrelevant: harvest capacity is ordinary inventory space,
    * even if unrelated seed bags happen to be open or full. */
   if (profile.allowsDirectInventorySeed)
      return playerInv.freeSlots();
   /* A missing seed bag must not abort the farmer. Harvest into the player
    * inventory and use any matching seed/produce item found there. */
   if (jGetWindows("Seedbag").length == 0)
      return playerInv.freeSlots();
   return areaFarmerSeedBagFreeSlots();
}

function areaFarmerHarvestAndPlantCycle(profile, rect, harvestedPositions, cycleNumber) {
   var playerInv = checkInventory();
   var crops = areaFarmerFindCrops(profile, rect, harvestedPositions);
   var harvestedThisCycle = 0;
   var harvestedThisCyclePositions = [];
   if (crops.length == 0) {
      jToConsole("AREA FARMER: cycle " + cycleNumber + " found no mature crops; checking the whole area for planting.");
   } else {
      var capacity = areaFarmerHarvestCapacity(profile, playerInv);
      if (capacity <= 0) {
         jToConsole("AREA FARMER: cycle " + cycleNumber + " has no harvest capacity (bags full and inventory unavailable).");
         return 0;
      }
      if (crops.length > capacity) crops = crops.slice(0, capacity);
      jToConsole("AREA FARMER: cycle " + cycleNumber + " harvesting " + crops.length + " crop(s).");
      for (var i = 0; i < crops.length && !areaFarmerStop; i++) {
         if (areaFarmerHarvestCapacity(profile, checkInventory()) <= 0) break;
         var cropPos = crops[i].position();
         if (!areaFarmerHarvestOne(crops[i], i + 1, crops.length)) break;
         var harvestedTile = jTilify(cropPos);
         harvestedPositions.push(harvestedTile);
         harvestedThisCyclePositions.push(harvestedTile);
         harvestedThisCycle++;
      }
      /* Do not plant a different set of tiles after a failed harvest pass. */
      if (harvestedThisCycle == 0) return 0;
   }

   /* Harvested gobs disappear asynchronously; include the full selected
    * plowed area, not just the tiles that happened to contain crops. */
   jSleep(500);
   var targets = areaFarmerBuildPlantPositions(rect, harvestedThisCyclePositions);
   jToConsole("AREA FARMER: cycle " + cycleNumber + " has " + targets.length + " plowed planting target(s).");
   var plantedThisCycle = 0;
   for (var j = 0; j < targets.length && !areaFarmerStop; j++) {
      if (areaFarmerSeedItems(profile, checkInventory()).length == 0) break;
      if (areaFarmerPlantOne(profile, targets[j], j + 1, targets.length)) plantedThisCycle++;
   }
   jToConsole("AREA FARMER: cycle " + cycleNumber + " replanted " + plantedThisCycle + "/" + targets.length + ".");
   return harvestedThisCycle;
}

function runAreaFarmer() {
   var profile = areaFarmerChooseProfile();
   if (profile == null) return;
   jToConsole("AREA FARMER: selected " + profile.label + ".");

   var inv = checkInventory();
   var bagCount = areaFarmerSeedBagCount(inv);
   if (bagCount == 0)
      jToConsole("AREA FARMER: no seed bags found; using player inventory as the seed source/capacity.");
   if (bagCount > 0 && !areaFarmerOpenSeedbags(inv)) {
      jToConsole("AREA FARMER: falling back to player inventory; seed-bag windows could not be opened.");
   }

   jToConsole("AREA FARMER: select the plowed field.");
   var rect = selectAreaInRect_mouse("Select the plowed field");
   if (rect == null || rect[4] == null) return;
   var harvested = [];
   var cycle = 1;
   while (!areaFarmerStop) {
      var harvestedThisCycle = areaFarmerHarvestAndPlantCycle(profile, rect, harvested, cycle);
      if (harvestedThisCycle == 0) break;
      if (areaFarmerSeedItems(profile, checkInventory()).length == 0) {
         jToConsole("AREA FARMER: no matching " + profile.label + " seeds remain; planting stopped.");
         break;
      }
      /* Planting can free seed-bag slots. Re-scan and run another harvest /
       * planting cycle until no mature crop or capacity remains. */
      cycle++;
   }
   jToConsole("AREA FARMER: finished after " + (cycle - 1) + " cycle(s).");
}

function main() {
   jDropLastWindow();
   try {
      runAreaFarmer();
   } catch (ex) {
      jToConsole("AREA FARMER ERROR: " + ex);
      jPrint("AREA FARMER ERROR: " + ex);
   }
}

main();
