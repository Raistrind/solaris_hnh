//#! name = Farmer
//#! uniq = farmer_apxproductions
//#! icon = gfx/invobjs/carrot

/*
 * Area Farmer for Legacy Haven & Hearth.
 *
 * This file intentionally contains only the current area workflow.  The old
 * crop-specific farmer and its first crop menu were removed: keeping both
 * workflows in one script made it possible for stale globals and duplicate
 * helpers to intercept the new menu action.
 */
include("pathfinder");
include("jBotAPI");
include("jBotErik");

var AREA_FARMER_TIMEOUT = 1000 * 60 * 2;
var AREA_FARMER_UI_TIMEOUT = 1000 * 60 * 5;
var AREA_FARMER_PLANT_TIMEOUT = 1000 * 10;
var AREA_FARMER_MOVE_TIMEOUT = 1000 * 15;
var AREA_FARMER_HARVEST_VERIFY_TIMEOUT = 1000 * 10;
var AREA_FARMER_TAKE_RECOVERY_TIMEOUT = 1000 * 3;
var areaFarmerStop = false;
var areaFarmerSeedbagWindows = [];
var areaFarmerDraggedSeedSource = null;

function areaFarmerNow() {
   return new Date().getTime();
}

function areaFarmerResult(reason) {
   return { reason: reason, harvested: 0, planted: 0, discarded: 0, skipped: 0 };
}

function areaFarmerRemaining(deadline) {
   return Math.max(0, deadline - areaFarmerNow());
}

function AreaCropProfile(label, cropName, seedNames, cropStages, allowsDirectInventorySeed, stagesAreDisplayed) {
   this.label = label;
   this.cropName = cropName;
   this.cropSeedNames = (seedNames instanceof Array) ? seedNames : [seedNames];
   /* Most legacy profiles historically use the blob stage directly. A few
    * profiles, notably carrots, are configured in the displayed terminology
    * (one higher than the zero-based plant blob stage). */
   if (!(cropStages instanceof Array)) cropStages = [cropStages];
   this.cropStages = [];
   for (var i = 0; i < cropStages.length; i++)
      this.cropStages.push(stagesAreDisplayed == true ? cropStages[i] - 1 : cropStages[i]);
   this.cropStage = this.cropStages[0];
   /* Some Legacy crops can be replanted from the harvested item itself. */
   this.allowsDirectInventorySeed = allowsDirectInventorySeed == true;
}

function areaFarmerProfiles() {
   return [
      /* Displayed stage 4 produces carrot seeds; displayed stage 5 is final. */
      new AreaCropProfile("Carrot", "plants/carrot", ["gfx/invobjs/seed-carrot", "gfx/invobjs/carrot"], [4, 5], true, true),
      new AreaCropProfile("Poppy", "plants/poppy", "gfx/invobjs/seed-poppy", 4),
      new AreaCropProfile("Wheat", "plants/wheat", ["gfx/invobjs/seed-wheat", "gfx/invobjs/wheat"], 3),
      new AreaCropProfile("Hemp", "plants/hemp", "gfx/invobjs/seed-hemp", 4),
      new AreaCropProfile("Beetroot", "plants/beetroot", ["gfx/invobjs/beetroot", "gfx/invobjs/seed-beetroot"], 3, true),
      new AreaCropProfile("Grapes", "plants/wine", ["gfx/invobjs/seed-grape", "gfx/invobjs/grapes"], 3),
      new AreaCropProfile("Tea", "plants/tea", "gfx/invobjs/seed-tea", 3),
      new AreaCropProfile("Flax", "plants/flax", "gfx/invobjs/flaxseed", 3),
      new AreaCropProfile("Peppercorn", "plants/pepper", ["gfx/invobjs/peppercorn", "gfx/invobjs/seed-pepper", "gfx/invobjs/pepper"], 3),
      new AreaCropProfile("Hops", "plants/hops", ["gfx/invobjs/hopcones", "gfx/invobjs/hop-cones", "gfx/invobjs/seed-hops"], 3),
      new AreaCropProfile("Peas", "plants/peas", ["gfx/invobjs/peapod", "gfx/invobjs/seed-peas"], 4, true),
      new AreaCropProfile("Onions", "plants/onion", ["gfx/invobjs/onion", "gfx/invobjs/red-onion", "gfx/invobjs/yellow-onion"], 3, true),
      new AreaCropProfile("Tobacco", "plants/tobacco", "gfx/invobjs/seed-tobacco", 3),
      new AreaCropProfile("Pumpkin", "plants/pumpkin", "gfx/invobjs/seed-pumpkin", 6)
   ];
}

function areaFarmerChooseMode() {
   var win = null;
   try {
      win = jGUIWindow(jCoord(300, 250), jCoord(220, 160), "Area Farmer");
      jGUILabel(win, jCoord(5, 5), "Choose a field workflow:");
      jGUIButton(win, jCoord(5, 25), 210, "Harvest");
      jGUIButton(win, jCoord(5, 50), 210, "Harvest and plant");
      jGUIButton(win, jCoord(5, 75), 210, "Harvest, plant and throw");
      jGUIButton(win, jCoord(5, 100), 210, "Plant");
      jGUIButton(win, jCoord(5, 125), 210, "Exit");
      win.toggleCloseButton();
      var selected = win.waitButtonClick(AREA_FARMER_UI_TIMEOUT);
      if (selected == null || selected == "" || selected == "Exit") return null;
      return selected;
   } finally {
      if (win != null) win.destroy();
   }
}

function areaFarmerChooseProfile() {
   var profiles = areaFarmerProfiles();
   var win = null;
   try {
      var height = 30 + ((profiles.length + 1) * 25);
      win = jGUIWindow(jCoord(300, 250), jCoord(220, height), "Area Farmer");
      jGUILabel(win, jCoord(5, 5), "Select the crop in the area:");
      var i;
      for (i = 0; i < profiles.length; i++)
         jGUIButton(win, jCoord(5, 25 + i * 25), 210, profiles[i].label);
      jGUIButton(win, jCoord(5, 25 + profiles.length * 25), 210, "Exit");
      win.toggleCloseButton();
      var selected = win.waitButtonClick(AREA_FARMER_UI_TIMEOUT);
      if (selected == null || selected == "" || selected == "Exit") return null;
      for (i = 0; i < profiles.length; i++)
         if (selected == profiles[i].label) return profiles[i];
      jToConsole("AREA FARMER: unknown crop button '" + selected + "'.");
      return null;
   } finally {
      if (win != null) win.destroy();
   }
}

function areaFarmerWindowInventory(wnd) {
   var waited = 0;
   while (wnd != null && waited < AREA_FARMER_TIMEOUT) {
      var inventories = wnd.getInventories();
      if (inventories != null && inventories.length > 0) return inventories[0];
      jSleep(100);
      waited += 100;
   }
   return null;
}

function areaFarmerOpenSeedbags(inv) {
   var alreadyOpen = jGetWindows("Seedbag");
   if (alreadyOpen.length > 0) {
      areaFarmerSeedbagWindows = alreadyOpen;
      jToConsole("AREA FARMER: using " + alreadyOpen.length + " already-open Seedbag window(s).");
      return true;
   }
   var bags = inv.getItems("invobjs/bag-seed");
   if (bags.length == 0) return false;
   var target = bags.length;
   jToConsole("AREA FARMER: opening " + target + " carried seed bag(s).");
   var i;
   for (i = 0; i < bags.length; i++) {
      if (bags[i].isActual()) bags[i].iact();
      jSleep(150);
   }
   var waited = 0;
   while (jGetWindows("Seedbag").length < target && waited < AREA_FARMER_TIMEOUT) {
      jSleep(100);
      waited += 100;
   }
   var opened = jGetWindows("Seedbag");
   areaFarmerSeedbagWindows = opened;
   if (opened.length < target)
      jToConsole("AREA FARMER: only " + opened.length + "/" + target + " carried seed bags opened; continuing with those available.");
   return opened.length > 0;
}

function areaFarmerSeedBagCount(inv) {
   return inv.getItems("invobjs/bag-seed").length;
}

function areaFarmerSeedBagFreeSlots() {
   var free = 0;
   var windows = areaFarmerSeedbagWindows;
   for (var i = 0; i < windows.length; i++) {
      var inv = areaFarmerWindowInventory(windows[i]);
      if (inv != null) free += inv.freeSlots();
   }
   return free;
}

function areaFarmerGetSeedItems(inv, names) {
   /* Use exact resource matching. getItems() is substring-based, so a
    * request for invobjs/beetroot would otherwise also return beetrootleaves. */
   var all = [], seenNames = {};
   for (var i = 0; i < names.length; i++) {
      if (seenNames[names[i]]) continue;
      seenNames[names[i]] = true;
      var found = inv.getEqualItems(names[i]);
      for (var j = 0; j < found.length; j++) all.push(found[j]);
   }
   return all;
}

function areaFarmerSeedItems(profile, playerInv) {
   var seeds = [];
   var windows = areaFarmerSeedbagWindows;
   var i, j, inv, found;
   for (i = 0; i < windows.length; i++) {
      inv = areaFarmerWindowInventory(windows[i]);
      if (inv == null) continue;
      found = areaFarmerGetSeedItems(inv, profile.cropSeedNames);
      for (j = 0; j < found.length; j++)
         if (found[j].isActual()) seeds.push({ item: found[j], inventory: inv });
   }
   found = areaFarmerGetSeedItems(playerInv, profile.cropSeedNames);
   for (i = 0; i < found.length; i++)
      if (found[i].isActual()) seeds.push({ item: found[i], inventory: playerInv });
   seeds.sort(function(a, b) { return b.item.quality() - a.item.quality(); });
   return seeds;
}

function areaFarmerSortCrops(crops, origin) {
   crops.sort(function(a, b) {
      var ap = a.position(), bp = b.position();
      var ay = Math.floor((ap.y - origin.y) / 11), by = Math.floor((bp.y - origin.y) / 11);
      if (ay != by) return ay - by;
      var ax = Math.floor((ap.x - origin.x) / 11), bx = Math.floor((bp.x - origin.x) / 11);
      return ((ay & 1) == 0) ? ax - bx : bx - ax;
   });
}

function areaFarmerWalkTo(pos) {
   var target = jTilify(pos);
   if (jMyCoords().dist(target) <= 33) return true;
   var deadline = areaFarmerNow() + AREA_FARMER_MOVE_TIMEOUT;
   for (var attempt = 1; attempt <= 2 && areaFarmerRemaining(deadline) > 0; attempt++) {
      resetCursor();
      if (jIsPathFree(target)) jAbsClick(target, 1, 0);
      else if (jPFMove(target) <= 0) continue;
      if (!jWaitStartMove(Math.min(1500, areaFarmerRemaining(deadline)))) continue;
      while (jIsMoving() && areaFarmerRemaining(deadline) > 0)
         jWaitEndMove(Math.min(500, areaFarmerRemaining(deadline)));
      if (!jIsMoving() && jMyCoords().dist(target) <= 33) return true;
   }
   return false;
}

function areaFarmerHarvestOne(crop, ordinal, total, reserveFreeSlots) {
   var result = areaFarmerResult("HARVEST_FAILED");
   if (reserveFreeSlots == null) reserveFreeSlots = 0;
   if (crop == null || !crop.isActual()) {
      result.reason = "CROP_NOT_PRESENT";
      result.skipped = 1;
      return result;
   }
   if (checkInventory().freeSlots() <= reserveFreeSlots) {
      jToConsole("AREA FARMER: inventory full; stopped harvest at " + ordinal + "/" + total + ".");
      result.reason = "INVENTORY_FULL";
      return result;
   }
   var pos = crop.position();
   if (!areaFarmerWalkTo(pos)) {
      result.reason = "MOVE_FAILED";
      return result;
   }
   resetCursor();
   jSendAction("harvest");
   if (!jWaitCursor("harvest", AREA_FARMER_TIMEOUT)) {
      result.reason = "HARVEST_CURSOR_FAILED";
      return result;
   }
   jDoClick(crop.getID(), 1, 0);
   jWaitProgress(AREA_FARMER_TIMEOUT);
   var deadline = areaFarmerNow() + AREA_FARMER_HARVEST_VERIFY_TIMEOUT;
   while (crop.isActual() && areaFarmerRemaining(deadline) > 0) jSleep(100);
   if (crop.isActual()) {
      result.reason = "HARVEST_NOT_CONFIRMED";
      return result;
   }
   result.reason = "OK";
   result.harvested = 1;
   jToConsole("AREA FARMER: harvested " + ordinal + "/" + total + ".");
   return result;
}

function areaFarmerRecoverDraggedSeed(inv, slot) {
   if (!jIsDragging()) return true;
   inv.drop(slot);
   if (jWaitDrop(2000)) return true;
   return false;
}

function areaFarmerPlantOne(profile, pos, ordinal, total) {
   var result = areaFarmerResult("PLANT_FAILED");
   var playerInv = checkInventory();
   var seeds = areaFarmerSeedItems(profile, playerInv);
   if (seeds.length == 0) {
      result.reason = "NO_SEEDS";
      return result;
   }
   if (!areaFarmerWalkTo(pos)) {
      result.reason = "MOVE_FAILED";
      return result;
   }
   resetCursor();
   var seedCandidate = seeds[0];
   var seed = seedCandidate.item;
   if (!seed.isActual()) {
      result.reason = "SEED_NOT_PRESENT";
      return result;
   }
   var sourceInventory = seedCandidate.inventory;
   var sourceSlot = seed.coord();
   areaFarmerDraggedSeedSource = { inventory: sourceInventory, slot: sourceSlot };
   seed.take();
   if (!jWaitDrag(AREA_FARMER_TIMEOUT)) {
      var takeRecoveryDeadline = areaFarmerNow() + AREA_FARMER_TAKE_RECOVERY_TIMEOUT;
      while (!jIsDragging() && areaFarmerRemaining(takeRecoveryDeadline) > 0) jSleep(100);
      if (jIsDragging()) {
         if (areaFarmerRecoverDraggedSeed(sourceInventory, sourceSlot)) {
            result.reason = "SEED_TAKE_FAILED_SEED_RETURNED";
            areaFarmerDraggedSeedSource = null;
         } else result.reason = "SEED_TAKE_FAILED_CURSOR_NOT_RECOVERED";
      } else result.reason = "SEED_TAKE_FAILED";
      return result;
   }
   /* The selected field coordinate is absolute. A relative (0, 0) click
    * plants beneath the player, which may be outside the chosen plowed tile. */
   jAbsInteractClick(pos, 0);
   if (!jWaitDrop(AREA_FARMER_PLANT_TIMEOUT)) {
      if (!areaFarmerRecoverDraggedSeed(sourceInventory, sourceSlot))
         result.reason = "PLANT_FAILED_CURSOR_NOT_RECOVERED";
      else {
         result.reason = "PLANT_FAILED_SEED_RETURNED";
         areaFarmerDraggedSeedSource = null;
      }
      if (!jIsDragging()) resetCursor();
      return result;
   }
   areaFarmerDraggedSeedSource = null;
   result.reason = "OK";
   result.planted = 1;
   jToConsole("AREA FARMER: replanted " + ordinal + "/" + total + ".");
   return result;
}

function areaFarmerHasPosition(pos, positions) {
   for (var i = 0; i < positions.length; i++)
      if (positions[i].x == pos.x && positions[i].y == pos.y) return true;
   return false;
}

function areaFarmerBuildPlantPositions(rect, harvestedPositions, plantedPositions) {
   var targets = [], emptyPlowed = [], area = rect[4];
   for (var h = 0; h < harvestedPositions.length; h++) {
      var harvestedPos = harvestedPositions[h];
      if (jAbsTileType(harvestedPos.div(11)) == 9) targets.push(harvestedPos);
   }
   for (var y = 0; y < area.y; y++) {
      for (var x = 0; x < area.x; x++) {
         var pos = jCoord(rect[0].x + x * 11, rect[0].y + y * 11);
         /* Legacy has one ordinary plowed-soil tile type (9). */
         if (jAbsTileType(pos.div(11)) != 9) continue;
         if (areaFarmerHasPosition(pos, plantedPositions)) continue;
         var existing = jFindMapObjectNearAbs(pos, 1, "plants/");
         if (existing != null) {
            continue;
         }
         if (!areaFarmerHasPosition(pos, harvestedPositions)) emptyPlowed.push(pos);
      }
   }
   return targets.concat(emptyPlowed);
}

function areaFarmerFindCropsAtStages(profile, rect, harvestedPositions, stages) {
   var area = rect[4];
   var crops = [];
   var seen = {};
   for (var stageIndex = 0; stageIndex < stages.length; stageIndex++) {
      var foundJava = jGetObjectsInRect(rect[0], area.sub(1, 1), stages[stageIndex], [profile.cropName]);
      for (var i = 0; i < foundJava.length; i++) {
         var gobKey = "" + foundJava[i].getID();
         if (seen[gobKey]) continue;
         seen[gobKey] = true;
         var pos = jTilify(foundJava[i].position());
         if (!areaFarmerHasPosition(pos, harvestedPositions)) crops.push(foundJava[i]);
      }
   }
   areaFarmerSortCrops(crops, rect[0]);
   return crops;
}

function areaFarmerFindCrops(profile, rect, harvestedPositions) {
   return areaFarmerFindCropsAtStages(profile, rect, harvestedPositions, profile.cropStages);
}

function areaFarmerDetectionStages() {
   /* Crop blobs are zero-based. Query every normal crop stage so an immature
    * plant still identifies its profile before Harvest and plant begins. */
   return [0, 1, 2, 3, 4, 5, 6];
}

function areaFarmerDetectFieldProfile(rect) {
   var profiles = areaFarmerProfiles();
   var matches = [];
   var stages = areaFarmerDetectionStages();
   for (var i = 0; i < profiles.length; i++) {
      var found = areaFarmerFindCropsAtStages(profiles[i], rect, [], stages);
      if (found.length > 0) matches.push({ profile: profiles[i], count: found.length });
   }
   if (matches.length == 0)
      return { profile: null, reason: "NO_RECOGNIZED_CROP" };
   if (matches.length > 1) {
      var labels = [];
      for (var j = 0; j < matches.length; j++) labels.push(matches[j].profile.label);
      return { profile: null, reason: "MIXED_CROPS: " + labels.join(", ") };
   }
   jToConsole("AREA FARMER: detected " + matches[0].count + " " + matches[0].profile.label + " plant(s) in the selected field.");
   return { profile: matches[0].profile, reason: "OK" };
}

function areaFarmerFindAllMatureCrops(rect) {
   var profiles = areaFarmerProfiles();
   var crops = [];
   for (var i = 0; i < profiles.length; i++) {
      var found = areaFarmerFindCrops(profiles[i], rect, []);
      for (var j = 0; j < found.length; j++)
         crops.push({ crop: found[j], profile: profiles[i] });
   }
   crops.sort(function(a, b) {
      var ap = a.crop.position(), bp = b.crop.position();
      var ay = Math.floor((ap.y - rect[0].y) / 11), by = Math.floor((bp.y - rect[0].y) / 11);
      if (ay != by) return ay - by;
      var ax = Math.floor((ap.x - rect[0].x) / 11), bx = Math.floor((bp.x - rect[0].x) / 11);
      return ((ay & 1) == 0) ? ax - bx : bx - ax;
   });
   return crops;
}

function areaFarmerSelectArea() {
   var selected = jAreaSelector();
   if (selected == null || selected.length < 4 || selected[2] == null || selected[3] == null) return null;
   var offs = selected[2];
   var area = selected[3];
   if (area.x <= 0 || area.y <= 0) return null;
   var start = selected[0];
   if (start == null) return null;
   jDrawGroundRect(offs, area);
   jDrawGroundRect(offs, jCoord(0, 0));
   return [
      jCoord(start.x, start.y),
      jCoord(start.x, start.y + 11 * (area.y - 1)),
      jCoord(start.x + 11 * (area.x - 1), start.y),
      jCoord(start.x + 11 * (area.x - 1), start.y + 11 * (area.y - 1)),
      area
   ];
}

function areaFarmerHarvestCapacity(profile, playerInv) {
   /* Harvest result delivery is not explicitly transferred into Seedbags by
    * this script, so only ordinary inventory space is a safe hard limit. */
   return playerInv.freeSlots();
}

function areaFarmerDiscardLowestQualityProfileItems(profile, playerInv) {
   var result = { reason: "NO_DISCARDABLE_PROFILE_ITEMS", discarded: 0 };
   /* Restrict this destructive action to items in the player's own inventory
    * that are exact resource matches for the detected crop profile. Seedbag
    * contents and unrelated inventory items are deliberately never touched. */
   var candidates = areaFarmerGetSeedItems(playerInv, profile.cropSeedNames);
   var actual = [];
   for (var i = 0; i < candidates.length; i++)
      if (candidates[i].isActual()) actual.push(candidates[i]);
   if (actual.length == 0) return result;

   actual.sort(function(a, b) {
      var qualityOrder = a.quality() - b.quality();
      if (qualityOrder != 0) return qualityOrder;
      var ac = a.coord(), bc = b.coord();
      if (ac.y != bc.y) return ac.y - bc.y;
      return ac.x - bc.x;
   });
   /* The item API cannot split a stack safely. Keep one matching stack so
    * this mode can still replant even when all available seeds are carried
    * in the player inventory rather than a Seedbag. */
   var discardCount = Math.floor(actual.length / 2);
   if (discardCount == 0) {
      result.reason = "INSUFFICIENT_PROFILE_ITEMS_TO_DISCARD";
      return result;
   }
   jToConsole("AREA FARMER: inventory full; throwing away " + discardCount + "/" + actual.length + " lowest-quality " + profile.label + " seed/plant item stack(s).");
   for (i = 0; i < discardCount; i++) {
      if (!actual[i].isActual()) continue;
      actual[i].drop();
      jSleep(200);
      result.discarded++;
   }
   if (result.discarded == 0) return result;
   if (playerInv.freeSlots() <= 0) {
      result.reason = "DISCARD_DID_NOT_FREE_INVENTORY_SPACE";
      return result;
   }
   result.reason = "OK";
   return result;
}

function areaFarmerEnsureHarvestCapacity(profile, playerInv, throwWhenFull) {
   var result = { reason: "OK", discarded: 0 };
   if (areaFarmerHarvestCapacity(profile, playerInv) > 0) return result;
   if (!throwWhenFull) {
      result.reason = "NO_HARVEST_CAPACITY";
      return result;
   }
   var discard = areaFarmerDiscardLowestQualityProfileItems(profile, playerInv);
   result.discarded = discard.discarded;
   if (discard.reason != "OK") result.reason = discard.reason;
   return result;
}

function areaFarmerHarvestAndPlantCycle(profile, rect, harvestedPositions, plantedPositions, cycleNumber, throwWhenFull) {
   var result = areaFarmerResult("NO_MATURE_CROPS");
   var playerInv = checkInventory();
   var crops = areaFarmerFindCrops(profile, rect, harvestedPositions);
   var harvestedThisCyclePositions = [];
   if (crops.length > 0) {
      var capacityCheck = areaFarmerEnsureHarvestCapacity(profile, playerInv, throwWhenFull);
      result.discarded += capacityCheck.discarded;
      if (capacityCheck.reason != "OK") {
         jToConsole("AREA FARMER: cycle " + cycleNumber + " stopped before harvest: " + capacityCheck.reason + ".");
         result.reason = capacityCheck.reason;
         return result;
      }
      var capacity = areaFarmerHarvestCapacity(profile, playerInv);
      if (crops.length > capacity) crops = crops.slice(0, capacity);
      jToConsole("AREA FARMER: cycle " + cycleNumber + " harvesting " + crops.length + " crop(s).");
      for (var i = 0; i < crops.length && !areaFarmerStop; i++) {
         capacityCheck = areaFarmerEnsureHarvestCapacity(profile, checkInventory(), throwWhenFull);
         result.discarded += capacityCheck.discarded;
         if (capacityCheck.reason != "OK") {
            jToConsole("AREA FARMER: cycle " + cycleNumber + " stopped before harvest: " + capacityCheck.reason + ".");
            result.reason = capacityCheck.reason;
            break;
         }
         var cropPos = crops[i].position();
         var harvest = areaFarmerHarvestOne(crops[i], i + 1, crops.length);
         result.harvested += harvest.harvested;
         result.skipped += harvest.skipped;
         if (harvest.harvested == 0) {
            result.reason = harvest.reason;
            break;
         }
         var harvestedTile = jTilify(cropPos);
         harvestedPositions.push(harvestedTile);
         harvestedThisCyclePositions.push(harvestedTile);
      }
   }

   var targets = areaFarmerBuildPlantPositions(rect, harvestedThisCyclePositions, plantedPositions);
   jToConsole("AREA FARMER: selected " + rect[4].x + "x" + rect[4].y + " tiles; cycle " + cycleNumber + " has " + targets.length + " plowed planting target(s).");
   for (var j = 0; j < targets.length && !areaFarmerStop; j++) {
      if (areaFarmerSeedItems(profile, checkInventory()).length == 0) {
         result.reason = "NO_SEEDS";
         break;
      }
      var planting = areaFarmerPlantOne(profile, targets[j], j + 1, targets.length);
      result.planted += planting.planted;
      result.skipped += planting.skipped;
      if (planting.planted == 0) {
         result.reason = planting.reason;
         break;
      }
      plantedPositions.push(targets[j]);
   }
   jToConsole("AREA FARMER: cycle " + cycleNumber + " replanted " + result.planted + "/" + targets.length + ".");
   if (areaFarmerStop) result.reason = "STOPPED";
   else if (result.reason == "NO_MATURE_CROPS" && result.harvested > 0) result.reason = "OK";
   else if (result.reason == "NO_MATURE_CROPS" && result.planted > 0) result.reason = "FILL_COMPLETE";
   return result;
}

function areaFarmerPrepareSeedSources() {
   var inv = checkInventory();
   var bagCount = areaFarmerSeedBagCount(inv);
   var existingSeedbagCount = jGetWindows("Seedbag").length;
   if (bagCount == 0 && existingSeedbagCount == 0)
      jToConsole("AREA FARMER: no seed bags found; using player inventory as the seed source/capacity.");
   if (existingSeedbagCount > 0 || bagCount > 0) {
      if (!areaFarmerOpenSeedbags(inv))
         jToConsole("AREA FARMER: falling back to player inventory; no usable Seedbag windows were opened.");
   }
}

function areaFarmerRunHarvestOnly(rect) {
   var totals = areaFarmerResult("NO_MATURE_CROPS");
   var crops = areaFarmerFindAllMatureCrops(rect);
   if (crops.length == 0) {
      jToConsole("AREA FARMER: no recognized mature crops found in the selected field.");
      return totals;
   }
   jToConsole("AREA FARMER: harvesting " + crops.length + " recognized mature crop(s); one inventory slot will remain free.");
   for (var i = 0; i < crops.length && !areaFarmerStop; i++) {
      var harvest = areaFarmerHarvestOne(crops[i].crop, i + 1, crops.length, 1);
      totals.harvested += harvest.harvested;
      totals.skipped += harvest.skipped;
      if (harvest.harvested == 0) {
         totals.reason = harvest.reason;
         break;
      }
      totals.reason = "OK";
   }
   if (areaFarmerStop) totals.reason = "STOPPED";
   return totals;
}

function areaFarmerRunPlantOnly(profile, rect) {
   var totals = areaFarmerResult("NO_PLOWED_EMPTY_TILES");
   var plantedPositions = [];
   var targets = areaFarmerBuildPlantPositions(rect, [], plantedPositions);
   jToConsole("AREA FARMER: selected " + rect[4].x + "x" + rect[4].y + " tiles; planting " + targets.length + " empty plowed tile(s).");
   for (var i = 0; i < targets.length && !areaFarmerStop; i++) {
      if (areaFarmerSeedItems(profile, checkInventory()).length == 0) {
         totals.reason = "NO_SEEDS";
         break;
      }
      var planting = areaFarmerPlantOne(profile, targets[i], i + 1, targets.length);
      totals.planted += planting.planted;
      totals.skipped += planting.skipped;
      if (planting.planted == 0) {
         totals.reason = planting.reason;
         break;
      }
      plantedPositions.push(targets[i]);
      totals.reason = "OK";
   }
   if (areaFarmerStop) totals.reason = "STOPPED";
   return totals;
}

function areaFarmerRunHarvestAndPlant(profile, rect, throwWhenFull) {
   var harvested = [];
   var planted = [];
   var cycle = 1;
   var totals = areaFarmerResult("NO_MATURE_CROPS");
   while (!areaFarmerStop) {
      var cycleResult = areaFarmerHarvestAndPlantCycle(profile, rect, harvested, planted, cycle, throwWhenFull);
      totals.harvested += cycleResult.harvested;
      totals.planted += cycleResult.planted;
      totals.discarded += cycleResult.discarded;
      totals.skipped += cycleResult.skipped;
      totals.reason = cycleResult.reason;
      if (cycleResult.reason != "OK") {
         if (cycleResult.reason == "NO_SEEDS")
            jToConsole("AREA FARMER: no matching " + profile.label + " seeds remain; planting stopped.");
         break;
      }
      cycle++;
   }
   totals.cycles = cycle;
   return totals;
}

function areaFarmerPrintSummary(mode, totals) {
   jToConsole("AREA FARMER SUMMARY (" + mode + "): harvested=" + totals.harvested + ", planted=" + totals.planted + ", discarded=" + totals.discarded + ", skipped=" + totals.skipped + ", stopped=" + totals.reason + ".");
}

function runAreaFarmer() {
   var mode = areaFarmerChooseMode();
   if (mode == null) return;

   if (mode == "Harvest") {
      jToConsole("AREA FARMER: select the field to harvest.");
      var rect = areaFarmerSelectArea();
      if (rect == null) {
         jToConsole("AREA FARMER: field selection cancelled.");
         return;
      }
      areaFarmerPrepareSeedSources();
      areaFarmerPrintSummary(mode, areaFarmerRunHarvestOnly(rect));
      return;
   }

   var profile;
   if (mode == "Harvest and plant" || mode == "Harvest, plant and throw") {
      var throwWhenFull = mode == "Harvest, plant and throw";
      jToConsole("AREA FARMER: select the field to harvest and plant.");
      var rect = areaFarmerSelectArea();
      if (rect == null) {
         jToConsole("AREA FARMER: field selection cancelled.");
         return;
      }
      var detection = areaFarmerDetectFieldProfile(rect);
      if (detection.profile == null) {
         jToConsole("AREA FARMER: " + mode + " stopped: " + detection.reason + ". Select a field containing exactly one recognized crop type.");
         return;
      }
      profile = detection.profile;
      jToConsole("AREA FARMER: " + mode + " selected " + profile.label + ". Empty plowed tiles will be planted.");
      areaFarmerPrepareSeedSources();
      areaFarmerPrintSummary(mode, areaFarmerRunHarvestAndPlant(profile, rect, throwWhenFull));
      return;
   }

   if (mode != "Plant") {
      jToConsole("AREA FARMER: unknown workflow selection.");
      return;
   }

   /* Plant keeps the explicit crop picker, then fills every empty plowed
    * tile. Selection is deliberately last so seed sources are ready first. */
   profile = areaFarmerChooseProfile();
   if (profile == null) return;
   jToConsole("AREA FARMER: Plant selected " + profile.label + ".");
   areaFarmerPrepareSeedSources();
   jToConsole("AREA FARMER: select the field to plant.");
   var rect = areaFarmerSelectArea();
   if (rect == null) {
      jToConsole("AREA FARMER: field selection cancelled.");
      return;
   }
   areaFarmerPrintSummary(mode, areaFarmerRunPlantOnly(profile, rect));
}

function main() {
   jDropLastWindow();
   try {
      runAreaFarmer();
   } catch (ex) {
      jToConsole("AREA FARMER ERROR: " + ex);
      jPrint("AREA FARMER ERROR: " + ex);
   } finally {
      if (areaFarmerDraggedSeedSource != null) {
         var finalRecoveryDeadline = areaFarmerNow() + AREA_FARMER_TAKE_RECOVERY_TIMEOUT;
         while (!jIsDragging() && areaFarmerRemaining(finalRecoveryDeadline) > 0) jSleep(100);
         if (jIsDragging() && !areaFarmerRecoverDraggedSeed(areaFarmerDraggedSeedSource.inventory, areaFarmerDraggedSeedSource.slot))
            jToConsole("AREA FARMER: seed remains on the cursor; place it back manually before continuing.");
      }
      areaFarmerDraggedSeedSource = null;
   }
}

main();
